#!/bin/sh
# ramify: secret scan (installed by `ramify install secrets` or `ramify install guard`, as pre-commit and as pre-push).
# Stops a commit or a push whose content holds credentials (API keys, tokens, private keys), found by gitleaks.
# Prints the rule, file and line of each finding, never the secret. A false positive: add `gitleaks:allow` on
# that line or its fingerprint to .gitleaksignore. Skip once, on purpose: git commit/push --no-verify.
# With git config ramify.guardMain true (`ramify install guard`) it also keeps the default branch for the user,
# from agents that run git without Ramify's own hooks: no commit on it in the main checkout, no push to it from
# anywhere. The user lets one through with RAMIFY_ALLOW_MAIN=1, or all with git config ramify.allowMain true.

hook=$(basename "$0")
# pre-push gets one line per ref it sends on stdin: read once, for the guard and for the scan.
refs=""
[ "$hook" = pre-push ] && refs=$(cat)

# The default branch: origin's HEAD, else main / master / trunk / develop (as ramify finds it).
default_branch() {
  b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) && { echo "${b#origin/}"; return 0; }
  for b in main master trunk develop; do git show-ref --verify --quiet "refs/heads/$b" && { echo "$b"; return 0; }; done
  return 1
}

if [ "$(git config --bool ramify.guardMain 2>/dev/null)" = true ] && [ -z "${RAMIFY_ALLOW_MAIN:-}" ] \
  && [ "$(git config --bool ramify.allowMain 2>/dev/null)" != true ] && main=$(default_branch); then
  allow="(The user can let it through once with RAMIFY_ALLOW_MAIN=1, or in this repository with: git config ramify.allowMain true)"
  case "$hook" in
    pre-commit)
      # The main checkout is the one whose git dir is the common one; a worktree has a git dir of its own.
      if [ "$(git branch --show-current)" = "$main" ] \
        && [ "$(git rev-parse --path-format=absolute --git-dir)" = "$(git rev-parse --path-format=absolute --git-common-dir)" ]; then
        echo "ramify: $main is the shared branch of this repository, so nothing was committed. Commit on a branch of your own: ramify new <branch> gives one, in a folder of its own." >&2
        echo "$allow" >&2
        exit 1
      fi ;;
    pre-push)
      # <local ref> <local sha> <remote ref> <remote sha>: a push (or a delete) that would update the default branch.
      if printf '%s\n' "$refs" | awk -v r="refs/heads/$main" '$3 == r { hit = 1 } END { exit !hit }'; then
        echo "ramify: this push would update $main, the shared branch, so nothing was sent. Push a branch of your own; bringing it into $main is for the user to do." >&2
        echo "$allow" >&2
        exit 1
      fi ;;
  esac
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "ramify: gitleaks is not installed, so this $hook was not checked for secrets (brew install gitleaks)." >&2
  exit 0
fi

# Run gitleaks with the given log options (none: the staged changes); report and stop on a finding.
scan() {
  if [ "$#" -eq 0 ]; then
    out=$(gitleaks git --pre-commit --staged --redact -v --no-banner --no-color . 2>&1)
  else
    out=$(gitleaks git --log-opts="$*" --redact -v --no-banner --no-color . 2>&1)
  fi
  code=$?
  [ "$code" -eq 0 ] && return 0
  if printf '%s\n' "$out" | grep -q '^RuleID:'; then
    echo "ramify: possible secret found, $hook stopped. Nothing was committed or sent." >&2
    printf '%s\n' "$out" | awk '
      /^RuleID:/ { rule = $2 }
      /^File:/   { file = $2 }
      /^Line:/   { line = $2 }
      /^Commit:/ { commit = substr($2, 1, 7) }
      /^Fingerprint:/ { printf "  %s  %s:%s%s\n", rule, file, line, (commit ? "  (commit " commit ")" : ""); rule = file = line = commit = "" }
    ' >&2
    echo "Remove it (and rotate it if it is real). A false positive: add gitleaks:allow on that line or its fingerprint to .gitleaksignore." >&2
  else
    echo "ramify: gitleaks could not check this $hook, so it was stopped:" >&2
    printf '%s\n' "$out" | tail -3 >&2
  fi
  exit 1
}

case "$hook" in
  pre-commit) scan ;;
  pre-push)
    # <local ref> <local sha> <remote ref> <remote sha>, one line per ref being pushed (read in this shell, so
    # that exit stops the push).
    zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
    while read -r _ local _ remote; do
      [ -n "$local" ] || continue                         # nothing on stdin
      [ "$local" = "$zero" ] && continue                  # deleting a remote branch: nothing to send
      if [ "$remote" = "$zero" ] || ! git cat-file -e "$remote^{commit}" 2>/dev/null; then
        scan "$local --not --remotes=$1"                  # a new branch (or one not fetched): commits no remote has
      else
        scan "$remote..$local"
      fi
    done <<EOF
$refs
EOF
    ;;
esac
exit 0
