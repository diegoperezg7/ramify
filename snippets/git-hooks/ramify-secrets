#!/bin/sh
# ramify: secret scan (installed by `ramify install secrets`, as pre-commit and as pre-push).
# Stops a commit or a push whose content holds credentials (API keys, tokens, private keys), found by gitleaks.
# Prints the rule, file and line of each finding, never the secret. A false positive: add `gitleaks:allow` on
# that line or its fingerprint to .gitleaksignore. Skip once, on purpose: git commit/push --no-verify.

hook=$(basename "$0")

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "ramify: gitleaks is not installed, so this $hook was not checked for secrets (brew install gitleaks)." >&2
  exit 0
fi

# Run gitleaks with the given log options (none: the staged changes); report and stop on a finding.
scan() {
  if [ "$#" -eq 0 ]; then
    out=$(gitleaks git --pre-commit --staged --redact -v --no-banner --no-color . 2>&1)
  else
    out=$(gitleaks git --log-opts="$*" --redact -v --no-banner --no-color . 2>&1)
  fi
  code=$?
  [ "$code" -eq 0 ] && return 0
  if printf '%s\n' "$out" | grep -q '^RuleID:'; then
    echo "ramify: possible secret found, $hook stopped. Nothing was committed or sent." >&2
    printf '%s\n' "$out" | awk '
      /^RuleID:/ { rule = $2 }
      /^File:/   { file = $2 }
      /^Line:/   { line = $2 }
      /^Commit:/ { commit = substr($2, 1, 7) }
      /^Fingerprint:/ { printf "  %s  %s:%s%s\n", rule, file, line, (commit ? "  (commit " commit ")" : ""); rule = file = line = commit = "" }
    ' >&2
    echo "Remove it (and rotate it if it is real). A false positive: add gitleaks:allow on that line or its fingerprint to .gitleaksignore." >&2
  else
    echo "ramify: gitleaks could not check this $hook, so it was stopped:" >&2
    printf '%s\n' "$out" | tail -3 >&2
  fi
  exit 1
}

case "$hook" in
  pre-commit) scan ;;
  pre-push)
    # stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref being pushed.
    zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
    while read -r _ local _ remote; do
      [ "$local" = "$zero" ] && continue                  # deleting a remote branch: nothing to send
      if [ "$remote" = "$zero" ] || ! git cat-file -e "$remote^{commit}" 2>/dev/null; then
        scan "$local --not --remotes=$1"                  # a new branch (or one not fetched): commits no remote has
      else
        scan "$remote..$local"
      fi
    done ;;
esac
exit 0
