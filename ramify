  dir=$(abspwd)
  main_checkout "$dir" >/dev/null
  url="ramify://open?path=$(printf '%s' "$dir" | jq -sRr @uri 2>/dev/null || python3 -I -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1]))' "$dir")"
