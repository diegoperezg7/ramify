  done
  command -v python3 >/dev/null || die "python3 is required for the dashboard"
  main=$(main_checkout "$PWD")
  token=$(python3 -I -c 'import secrets; print(secrets.token_hex(16))')
  if [ -f "$SELF_DIR/ui/server.py" ]; then cd "$SELF_DIR/ui"
  elif [ -f "$SELF_DIR/../ui/server.py" ]; then cd "$SELF_DIR/../ui"
  else die "dashboard files not found next to $SELF_DIR"; fi
