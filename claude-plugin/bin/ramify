#!/bin/bash
# ramify: one git worktree per task, ready for any coding agent or IDE.
# https://github.com/diegoperezg7/ramify
set -euo pipefail

VERSION=0.10.1
ROOT="${RAMIFY_ROOT:-$HOME/.worktrees}"
PORT_MIN="${RAMIFY_PORT_MIN:-4100}"
PORT_MAX="${RAMIFY_PORT_MAX:-4990}"
PORT_BLOCK=10
# Process names counted as agents in `ls` (node/bun/python count as the worktree's recorded agent).
AGENT_NAMES="claude codex gemini copilot cursor-agent opencode qwen deepcode deepseek-tui deepseek deepy kimi kimi-code vibe grok amp droid kiro-cli qchat junie auggie qodercli codebuddy iflow mimo trae-cli hermes cline kilocode kilo goose crush openhands aider qodo letta codebuff plandex pdx gptme interpreter neovate tabnine"
SELF_DIR=$(cd "$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")" && pwd)
# Physical path of the current directory. Git Bash on Windows prints C:/... so git and
# native programs (the desktop app, editors) get paths they understand.
abspwd() { if [ -n "${MSYSTEM:-}" ]; then pwd -W; else pwd -P; fi; }

if { [ -t 2 ] || [ -n "${FORCE_COLOR:-}" ]; } && [ -z "${NO_COLOR:-}" ]; then
  B=$'\033[1m'; D=$'\033[2m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; M=$'\033[35m'; N=$'\033[0m'
else
  B=; D=; G=; Y=; R=; M=; N=
fi

log() { printf '%s\n' "$*" >&2; }
die() { log "${R}ramify:${N} $*"; exit 1; }

usage() {
  cat >&2 <<EOF
${B}ramify${N} $VERSION - one git worktree per task, for any coding agent or IDE

${B}Usage${N}
  ramify new  <branch> [-a agent] [-i ide] [-p prompt] [-f base] [--tmux] [--no-setup] [--no-launch] [-- agent args]
  ramify open <name>   [-a agent] [-i ide] [-p prompt] [--tmux] [-- agent args]
  ramify ls [--json]            worktrees, agent, activity, changes, ports
  ramify ui [--port N]          live web dashboard (needs python3)
  ramify app                    open this repository in the desktop app
  ramify graph [-n N]           branch graph of every worktree
  ramify who [path...]          other worktrees changing these files (exit 1 if any)
  ramify ready                  bring the base in, mark this branch ready to merge (1 overlap, 2 conflict)
  ramify path <name>            print a worktree path
  ramify rm <name> [--force]    remove a worktree (never deletes unmerged commits)
  ramify prune                  remove clean, merged worktrees
  ramify install [claude-plugin|claude-hooks|instructions|shell|secrets|guard|all]
  ramify uninstall [shell|instructions]  undo install shell / install instructions
  ramify run <agent> [args]     open an agent; from a main checkout it gets its own branch first
  ramify move <branch> [-a agent]  move the main checkout's uncommitted work to a branch of its own
  ramify hook create|remove|session-start|guard|nudge   Claude Code hooks

${B}Agents${N} (-a)   claude, codex, gemini, copilot, cursor, opencode, aider, amp, or any command
${B}IDEs${N}   (-i)   xcode, cursor, code, zed, idea, or any macOS app name

Each worktree lives in \$RAMIFY_ROOT/<repo>/<name> (default ~/.worktrees) and gets a
.worktree.env with WT_NAME, WT_BRANCH, WT_PATH, WT_MAIN, WT_AGENT, PORT and DERIVED_DATA.
EOF
}

# --- helpers -----------------------------------------------------------------

# Absolute, symlink-free git common dir of the repository containing $1.
common_dir() {
  local rel
  rel=$(git -C "$1" rev-parse --git-common-dir 2>/dev/null) || return 1
  (cd "$1" && cd "$rel" && abspwd)
}

main_checkout() {
  local common line cur=""
  common=$(common_dir "$1") || die "not a git repository: $1"
  if [ "$(git -C "$common" rev-parse --is-bare-repository 2>/dev/null)" = true ]; then
    # Bare repository with worktrees: the first non-bare worktree acts as the main checkout.
    while IFS= read -r line; do
      case "$line" in
        "worktree "*) cur=${line#worktree } ;;
        bare) cur="" ;;
        "") [ -n "$cur" ] && { (cd "$cur" && abspwd); return; } ;;
      esac
    done < <(git -C "$common" worktree list --porcelain; echo)
    die "bare repository without a checkout: $1 (add one with git worktree add)"
  fi
  dirname "$common"
}

# Export .worktree.env without executing it: values are data, never shell code.
load_env() {
  local k v
  [ -f "$1/.worktree.env" ] || return 0
  while IFS='=' read -r k v; do
    case "$k" in WT_*|PORT|DERIVED_DATA|SIM_*) export "$k=$v" ;; esac
  done < "$1/.worktree.env"
}

slugify() { printf '%s' "$1" | tr '/ ' '--' | tr -cd 'A-Za-z0-9._-'; }

env_get() { [ -f "$1/.worktree.env" ] || return 0; sed -n "s/^$2=//p" "$1/.worktree.env" | head -1; }

env_unset() {
  local f="$1/.worktree.env" tmp
  [ -f "$f" ] || return 0
  tmp=$(grep -v "^$2=" "$f" || true)
  printf '%s\n' "$tmp" | sed '/^$/d' > "$f"
}

env_set() {
  [ -f "$1/.worktree.env" ] || return 0
  env_unset "$1" "$2"
  printf '%s=%s\n' "$2" "$3" >> "$1/.worktree.env"
}

# A folder under $ROOT/<name> belongs to this repository: two repositories with the same folder name share it.
of_repo() { [ "$( (main_checkout "$1") 2>/dev/null)" = "$2" ]; }

# Worktree path from its folder name, branch or path.
find_wt() {
  local main="$1" name="$2" repo path="" line cur=""
  repo=$(basename "$main")
  if [ -d "$name/.git" ] || [ -f "$name/.git" ]; then (cd "$name" && pwd); return; fi
  if [ -d "$ROOT/$repo/$(slugify "$name")" ] && of_repo "$ROOT/$repo/$(slugify "$name")" "$main"; then
    (cd "$ROOT/$repo/$(slugify "$name")" && abspwd); return
  fi
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) cur=${line#worktree } ;;
      "branch refs/heads/$name") path=$cur ;;
    esac
    if [ -z "$path" ] && [ -n "$cur" ] && [ "$cur" != "$main" ] && [ "$(basename "$cur")" = "$name" ]; then
      path=$cur
    fi
  done < <(git -C "$main" worktree list --porcelain)
  [ -n "$path" ] || die "no worktree named '$name' (see: ramify ls)"
  printf '%s\n' "$path"
}

# The first free block of PORT_BLOCK ports: no worktree has it and nothing listens on any port of it.
alloc_port() {
  local used listening p q free
  # The ports in use, one per line between newlines. Looked up in bash, not with printf | grep -q: under pipefail a
  # grep that stops at the first match can leave printf writing to a closed pipe, and a taken port then read as free.
  used=$'\n'$(cat "$ROOT"/*/*/.worktree.env 2>/dev/null | sed -n 's/^PORT=//p' || true)$'\n'
  listening=$'\n'$(listening_ports)$'\n'
  p=$PORT_MIN
  while [ "$p" -le "$PORT_MAX" ]; do
    case "$used" in
      *$'\n'"$p"$'\n'*) ;;
      *)
        free=1; q=$p
        while [ "$q" -lt $((p + PORT_BLOCK)) ]; do
          case "$listening" in *$'\n'"$q"$'\n'*) free=0; break ;; esac
          q=$((q + 1))
        done
        [ "$free" = 0 ] || { printf '%s\n' "$p"; return; } ;;
    esac
    p=$((p + PORT_BLOCK))
  done
  die "no free port block between $PORT_MIN and $PORT_MAX"
}

# A file holding its owner's pid, created with noclobber: bash itself opens it with O_EXCL, so one ramify gets it.
# Not mkdir: uutils mkdir, the default on Ubuntu 26.04, can tell two callers racing for one name that each made it.
PORT_LOCK="$ROOT/.port-lock"
port_lock() {
  local i=0
  mkdir -p "$ROOT"
  until (set -C; printf '%s\n' "$$" > "$PORT_LOCK") 2>/dev/null; do
    # A folder is the lock of a ramify up to 0.8, with no pid in it: taken over as those did, once a minute old.
    if [ -d "$PORT_LOCK" ] && [ -n "$(find "$PORT_LOCK" -maxdepth 0 -mmin +1 2>/dev/null)" ] && rmdir "$PORT_LOCK" 2>/dev/null; then
      continue
    fi
    # Its owner is no longer running (killed while holding it): taken over, judged by the pid, never by age.
    reclaim_stale "$PORT_LOCK" && continue
    i=$((i + 1)); [ "$i" -lt 300 ] || die "another ramify holds $PORT_LOCK; remove it if none is running"
    sleep 0.1
  done
}
port_unlock() { rm -f "$PORT_LOCK"; }

# The pid written in a lock file, or nothing: no file, one being written this instant, or no pid in it.
pid_in() {
  local h=""
  { read -r h < "$1"; } 2>/dev/null || true
  case "$h" in ''|*[!0-9]*) ;; *) printf '%s\n' "$h" ;; esac
}

# Remove the lock file $1 when the process named in it is no longer running. One taker at a time (a noclobber
# file of its own), and only while the lock still names that process: a fresh one taken meanwhile stays.
reclaim_stale() {
  local f="$1" holder
  holder=$(pid_in "$f")
  if [ -z "$holder" ] || kill -0 "$holder" 2>/dev/null; then return 1; fi
  (set -C; : > "$f.$holder") 2>/dev/null || return 1
  if [ "$(pid_in "$f")" = "$holder" ]; then rm -f "$f"; fi
  rm -f "$f.$holder"
}

# The TCP ports something listens on here, one per line (none without lsof).
listening_ports() {
  command -v lsof >/dev/null || return 0
  lsof -nP -iTCP -sTCP:LISTEN -Fn 2>/dev/null | sed -n 's/^n.*:\([0-9][0-9]*\)$/\1/p' | sort -u || true
}

# Copy the ignored files listed in .worktreeinclude (gitignore syntax) into the worktree.
copy_included() {
  local main="$1" wt="$2" files
  [ -f "$main/.worktreeinclude" ] || return 0
  files=$(cd "$main" && git ls-files --others --ignored --exclude-from=.worktreeinclude \
    | grep -v '^\.claude/worktrees/' || true)
  [ -n "$files" ] || return 0
  log "${D}copying $(printf '%s\n' "$files" | wc -l | tr -d ' ') file(s) from .worktreeinclude${N}"
  (cd "$main" && printf '%s\n' "$files" | tar -cf - -T -) | (cd "$wt" && tar -xpf -)
}

exclude_env_file() {
  local common
  common=$(common_dir "$1")
  mkdir -p "$common/info"
  grep -qx '/.worktree.env' "$common/info/exclude" 2>/dev/null \
    || printf '/.worktree.env\n' >> "$common/info/exclude"
}

# Run .worktree/<name>.sh from the worktree, or from the main checkout if it is not tracked.
run_project_script() {
  local wt="$1" main="$2" which="$3" s=""
  if [ -x "$wt/.worktree/$which.sh" ]; then s="$wt/.worktree/$which.sh"
  elif [ -x "$main/.worktree/$which.sh" ]; then s="$main/.worktree/$which.sh"; fi
  [ -n "$s" ] || return 1
  log "${D}$which: $s${N}"
  (cd "$wt" && load_env "$wt" && "$s") >&2
}

auto_setup() {
  (
    cd "$1"
    load_env "$1"
    if [ -f project.yml ] && command -v xcodegen >/dev/null; then
      log "${D}setup: xcodegen generate${N}"; xcodegen generate --quiet
    fi
    if [ -f package.json ]; then
      if [ -f pnpm-lock.yaml ]; then log "${D}setup: pnpm install${N}"; pnpm install --frozen-lockfile
      elif [ -f bun.lock ] || [ -f bun.lockb ]; then log "${D}setup: bun install${N}"; bun install --frozen-lockfile
      elif [ -f yarn.lock ]; then log "${D}setup: yarn install${N}"; yarn install --frozen-lockfile
      elif [ -f package-lock.json ]; then log "${D}setup: npm ci${N}"; npm ci
      else log "${D}setup: npm install${N}"; npm install; fi
    fi
    if [ -f uv.lock ] && command -v uv >/dev/null; then log "${D}setup: uv sync${N}"; uv sync; fi
  ) >&2
}

# Processes whose working directory is inside each worktree: "<path>\t<command>". lsof names a process after the
# file it runs, and Claude Code's is its version (~/.local/share/claude/versions/2.1.319, started through a claude
# symlink): a name that is no agent's is looked up in the command line it was started with, from one ps for all.
active_agents() {
  command -v lsof >/dev/null || return 0
  { ps -A -ww -o pid=,args= 2>/dev/null; lsof -a -d cwd -u "$(id -u)" -Fpcn 2>/dev/null; } | awk -v known="$AGENT_NAMES" '
    function agent(cmd, args,   w, d) {
      if (cmd in ok || args == "") return cmd
      # Started as "claude" (or any agent name), whatever the file it resolves to is called.
      w = args; sub(/ .*/, "", w); sub(/.*\//, "", w)
      if (w in ok) return w
      # Started by its full path (Claude Code teammates): .../claude/versions/<version>, the version being the name.
      # The name must be that version, so a path to it given as an argument (cat .../2.1.319) does not count.
      d = "/claude/versions/"
      if (cmd != "" && match(args, d "[^/ ]+") && index(substr(args, RSTART + length(d), RLENGTH - length(d)), cmd) == 1) return "claude"
      return cmd
    }
    BEGIN { n = split(known, k, " "); for (i = 1; i <= n; i++) ok[k[i]] = 1 }
    # ps lines start with the pid; lsof -F lines with a field letter.
    /^ *[0-9]+ / { sub(/^ +/, ""); p = $1; sub(/^[0-9]+ +/, ""); argv[p] = $0; next }
    /^p/ { pid = substr($0, 2); cmd = ""; next }
    /^c/ { cmd = substr($0, 2); next }
    /^n/ { print substr($0, 2) "\t" agent(cmd, argv[pid]) }'
}

# --- agents ------------------------------------------------------------------

# Sets AGENT_CMD and PROMPT_STYLE (arg | flag:<flag> | clipboard) for a known agent.
agent_profile() {
  case "$1" in
    claude)              AGENT_CMD=claude;       PROMPT_STYLE=arg ;;
    codex)               AGENT_CMD=codex;        PROMPT_STYLE=arg ;;
    gemini)              AGENT_CMD=gemini;       PROMPT_STYLE=flag:-i ;;
    copilot)             AGENT_CMD=copilot;      PROMPT_STYLE=flag:-i ;;
    cursor|cursor-agent) AGENT_CMD=cursor-agent; PROMPT_STYLE=arg ;;
    opencode)            AGENT_CMD=opencode;     PROMPT_STYLE=clipboard ;;
    aider)               AGENT_CMD=aider;        PROMPT_STYLE=clipboard ;;
    amp)                 AGENT_CMD=amp;          PROMPT_STYLE=clipboard ;;
    *)                   AGENT_CMD=$1;           PROMPT_STYLE=clipboard ;;
  esac
}

valid_agent() {
  case "$1" in ""|-*|*[!A-Za-z0-9._/-]*) die "invalid agent name: '$1'" ;; esac
}

copy_to_clipboard() {
  if command -v pbcopy >/dev/null; then printf '%s' "$1" | pbcopy
  elif command -v wl-copy >/dev/null; then printf '%s' "$1" | wl-copy
  elif command -v xclip >/dev/null; then printf '%s' "$1" | xclip -selection clipboard
  else return 1; fi
}

open_ide() {
  local ide="$1" wt="$2" proj app cli
  if [ "$ide" = xcode ]; then
    proj=$(ls -d "$wt"/*.xcworkspace 2>/dev/null | head -1 || true)
    [ -n "$proj" ] || proj=$(ls -d "$wt"/*.xcodeproj 2>/dev/null | head -1 || true)
    open -a Xcode "${proj:-$wt}"; return
  fi
  case "$ide" in
    cursor) app=Cursor; cli=cursor ;;
    code|vscode) app="Visual Studio Code"; cli=code ;;
    zed) app=Zed; cli=zed ;;
    idea) app="IntelliJ IDEA"; cli=idea ;;
    *) app=$ide; cli=$ide ;;
  esac
  if [ "$(uname)" = Darwin ] && open -Ra "$app" 2>/dev/null; then open -a "$app" "$wt"
  elif command -v "$cli" >/dev/null; then "$cli" "$wt" >/dev/null 2>&1 &
  else die "cannot open IDE '$ide'"; fi
}

# launch <wt> <agent> <ide> <prompt> <tmux> [agent args...]
launch() {
  local wt="$1" agent="$2" ide="$3" prompt="$4" tmux="$5" sess line
  shift 5
  [ -n "$ide" ] && open_ide "$ide" "$wt"
  if [ -z "$agent" ]; then
    [ -n "$ide" ] || log "cd \"$wt\""
    return 0
  fi
  valid_agent "$agent"
  agent_profile "$agent"
  command -v "$AGENT_CMD" >/dev/null || die "command not found: $AGENT_CMD"
  env_set "$wt" WT_AGENT "$agent"

  if [ -n "$prompt" ]; then
    case "$prompt" in -*) prompt=" $prompt" ;; esac
    case "$PROMPT_STYLE" in
      arg) set -- "$@" "$prompt" ;;
      flag:*) set -- "$@" "${PROMPT_STYLE#flag:}" "$prompt" ;;
      clipboard)
        if copy_to_clipboard "$prompt"; then log "${Y}$agent has no initial-prompt flag: prompt copied to the clipboard, paste it${N}"
        else log "${Y}$agent has no initial-prompt flag; prompt:${N} $prompt"; fi ;;
    esac
  fi

  if [ "$tmux" = 1 ]; then
    sess=$(printf '%s_%s' "$(basename "$(dirname "$wt")")" "$(basename "$wt")" | tr '.:' '__')
    set -- -d -s "$sess" -c "$wt" "$AGENT_CMD" "$@"
    while IFS= read -r line; do [ -n "$line" ] && set -- -e "$line" "$@"; done < "$wt/.worktree.env"
    # Started detached on purpose (the agent works in the background until attached): with destroy-unattached on,
    # tmux would end it at once, so this one session opts out in the same call that creates it.
    tmux new-session "$@" \; set-option -t "$sess" destroy-unattached off
    if [ -n "${TMUX:-}" ]; then log "tmux session ${B}$sess${N} started: tmux switch-client -t $sess"
    else log "tmux session ${B}$sess${N} started: tmux attach -t $sess"; fi
  else
    cd "$wt"
    load_env "$wt"
    exec "$AGENT_CMD" "$@"
  fi
}

# --- commands ----------------------------------------------------------------

# Create the worktree and leave its path in CREATED_WT. Not called inside $(...):
# bash 3.2 does not keep errexit in command substitutions.
create() {
  local branch="$1" from="$2" setup="$3" agent="$4" main repo slug wt port base
  main=$(main_checkout "$PWD") || exit 1
  repo=$(basename "$main")
  slug=$(slugify "$branch")
  [ -n "$slug" ] || die "invalid branch name: '$branch'"
  wt="$ROOT/$repo/$slug"
  [ -e "$wt" ] && die "$wt already exists (use: ramify open $branch)"
  [ -z "$agent" ] || valid_agent "$agent"
  mkdir -p "$ROOT/$repo" || die "could not create $ROOT/$repo"
  wt="$(cd "$ROOT/$repo" && abspwd)/$slug"

  local add
  if git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
    [ -n "$from" ] && log "${Y}branch $branch already exists; ignoring -f $from${N}"
    add=("$wt" "$branch")
  elif [ -z "$from" ] && git -C "$main" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    add=(--track -b "$branch" "$wt" "origin/$branch")
  else
    base=$(git rev-parse --verify --quiet "${from:-HEAD}^{commit}") \
      || die "base '${from:-HEAD}' does not exist (does the repository have a commit?)"
    add=(-b "$branch" "$wt" "$base")
  fi
  # Several git worktree add at once in one repository can fail (git reads .git/worktrees/<name> while another
  # one is writing its own): ramify runs them one at a time, under the same lock as the ports. Choosing a port and
  # writing it down is one step too: two worktrees made at once must not both pick the same block. The block is
  # chosen first, so with none free nothing is made. Every failure here stops ramify explicitly: create may run
  # where errexit does not (bash 3.2 drops it in $(...), and any bash in a && list).
  port_lock
  port=$(alloc_port) || { port_unlock; exit 1; }
  git -C "$main" worktree add "${add[@]}" >&2 || { port_unlock; die "git worktree add failed for $branch"; }
  cat > "$wt/.worktree.env" <<EOF || { port_unlock; die "could not write $wt/.worktree.env"; }
WT_NAME=$slug
WT_BRANCH=$branch
WT_PATH=$wt
WT_MAIN=$main
WT_AGENT=$agent
PORT=$port
DERIVED_DATA=$ROOT/$repo/.derived-data/$slug
EOF
  # The conversation it is for (hook create), recorded before the setup runs: another one looking now sees it taken.
  [ -z "${CREATE_SESSION:-}" ] || printf 'WT_SESSION=%s\n' "$CREATE_SESSION" >> "$wt/.worktree.env"
  port_unlock
  exclude_env_file "$wt" || die "could not exclude .worktree.env from git in $wt"
  copy_included "$main" "$wt" || die "could not copy the files of .worktreeinclude into $wt"

  if [ "$setup" = 1 ] && ! run_project_script "$wt" "$main" setup; then
    auto_setup "$wt" || log "${Y}warning: setup failed; the worktree is still at $wt${N}"
  fi
  log "${G}+${N} ${B}$slug${N}  branch ${M}$branch${N}  ports $port-$((port + PORT_BLOCK - 1))"
  CREATED_WT=$wt
}

# A JSON string. Control characters are escaped, not dropped: a path with a tab in it must come out as that path.
json_str() {
  local s=$1 out="" c i
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\t'/\\t}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}
  if [[ $s == *[$'\001'-$'\037']* ]]; then
    for ((i = 0; i < ${#s}; i++)); do
      c=${s:i:1}
      if [[ $c == [$'\001'-$'\037'] ]]; then printf -v c '\\u%04x' "'$c"; fi
      out+=$c
    done
    s=$out
  fi
  printf '"%s"' "$s"
}

# Agents running in a worktree folder, comma separated (at most 3): $1 the active_agents output, $2 the folder,
# $3 the agent recorded in its .worktree.env (a node/bun/python process there counts as that agent).
agents_in() {
  printf '%s\n' "$1" | awk -F'\t' -v p="$2" '$1 == p || index($1, p "/") == 1 { print $2 }' \
    | awk -v a="$3" -v known="$AGENT_NAMES" '
        BEGIN { n = split(known, k, " "); for (i = 1; i <= n; i++) ok[k[i]] = 1 }
        ok[$0] { print; next }
        a != "" && ($0 == "node" || $0 == "bun" || $0 ~ /^[Pp]ython/) { print a }' \
    | sort -u | head -3 | paste -sd, - || true
}

# Files a checkout changes: committed since it forked from the base, uncommitted and untracked, one per line.
touched_files() {
  local at="$1" base="$2" mb
  mb=$(git -C "$at" merge-base "$base" HEAD 2>/dev/null) || mb=HEAD
  { git -C "$at" diff --name-only "$mb" 2>/dev/null; git -C "$at" ls-files --others --exclude-standard 2>/dev/null; } | sort -u
}

# `ramify who [path...]`: which other worktrees of this repository change these files or folders (paths relative to
# the repository root, or absolute). Without paths, the files this worktree changes. Exit 1 when another one does.
cmd_who() {
  local main base here procs line cur="" branch="" agent active p rel hit=0 mine theirs f
  main=$(main_checkout "$PWD")
  base=$(default_branch "$main"); [ -n "$base" ] || base=HEAD
  here=$(git rev-parse --show-toplevel 2>/dev/null) || here=$PWD
  here=$(cd "$here" && abspwd)
  if [ $# -gt 0 ]; then
    mine=""
    for p in "$@"; do
      case "$p" in
        "$here"/*) rel=${p#"$here"/} ;;
        /*|[A-Za-z]:*) rel=$p ;;
        *) rel=$(git rev-parse --show-prefix 2>/dev/null)$p ;;
      esac
      mine="$mine${rel%/}"$'\n'
    done
  else
    mine=$(touched_files "$here" "$base")
  fi
  [ -n "$mine" ] || { log "nothing to check: no paths given and no changes here"; return 0; }
  procs=$(active_agents)
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) cur=${line#worktree }; branch="" ;;
      "branch "*) branch=${line#branch refs/heads/} ;;
      "")
        # WHO_QUEUE (the base tip, set by `ramify ready`): only the branches marked ready and still valid count.
        if [ -n "$cur" ] && [ -d "$cur" ] && [ "$(cd "$cur" && abspwd)" != "$here" ] \
          && { [ -z "${WHO_QUEUE:-}" ] || [ "$(ready_state "$cur" "$WHO_QUEUE")" = ready ]; }; then
          theirs=$(touched_files "$cur" "$base")
          if [ -n "$theirs" ]; then
            agent=$(env_get "$cur" WT_AGENT)
            if [ -n "$(agents_in "$procs" "$cur" "$agent")" ]; then active=working; else active=idle; fi
            # A path given matches a file of theirs that is that path or inside it (a folder).
            while IFS= read -r f; do
              printf '%s\n' "$mine" | awk -v f="$f" '$0 == f || index(f, $0 "/") == 1 || $0 == "." { found = 1 } END { exit !found }' || continue
              hit=1
              printf '%s\t%s\t%s\t%s\n' "${branch:-(detached)}" "${agent:--}" "$active" "$f"
            done <<< "$theirs"
          fi
        fi
        cur="" ;;
    esac
  done < <(git -C "$main" worktree list --porcelain; echo)
  [ "$hit" = 0 ] || return 1
}

# A commit id as git writes it (sha1 or sha256). .worktree.env can come from the repository itself: what it says
# is checked before git or the JSON of `ls` sees it.
is_oid() { [[ $1 =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]]; }

# Where a worktree stands in the merge queue against the base tip $2: "ready" while its HEAD is the commit
# `ramify ready` checked and the base is still in it, "stale" once either moved, "waiting" when ready found a branch
# marked before it that changes the same files, nothing when it was never marked or its work is in the base already
# (merged). A waiting branch had brought the base in before it began to wait, so base commits it lacks (behind) mean
# the base moved since: what it waited for may be merged, time to run ready again. Worked out on every read: no one
# rewrites another worktree's env.
ready_state() {
  local at="$1" tip="$2" mark markbase waitbase head
  mark=$(env_get "$at" WT_READY); markbase=$(env_get "$at" WT_READY_BASE); waitbase=$(env_get "$at" WT_READY_WAIT)
  is_oid "$tip" || return 0
  is_oid "$waitbase" || { is_oid "$mark" && is_oid "$markbase"; } || return 0
  head=$(git -C "$at" rev-parse -q --verify HEAD 2>/dev/null) || return 0
  ! git -C "$at" merge-base --is-ancestor HEAD "$tip" 2>/dev/null || return 0
  if is_oid "$waitbase"; then echo waiting; return 0; fi
  # The base moved to commits the branch already has (it brought them in itself): still ready.
  if [ "$head" = "$mark" ] && { [ "$tip" = "$markbase" ] || git -C "$at" merge-base --is-ancestor "$tip" HEAD 2>/dev/null; }; then
    echo ready
  else
    echo stale
  fi
}

# git fetch of the base $2 from origin into the checkout $1, stopped after $3 seconds: a remote that never answers
# (a network gone, a host that hangs) must not hold ramify ready. Bash 3.2 (macOS) has no timeout command, so the
# fetch runs in the background in a process group of its own (job control, set -m), and a watcher ends that whole
# group at the limit, helpers and ssh included, so nothing is left running. Exit 124 when it was stopped.
fetch_base() {
  local here="$1" base="$2" limit="$3" pid watcher rc=0 start=$SECONDS
  set -m
  GIT_TERMINAL_PROMPT=0 git -C "$here" fetch --quiet origin "$base" </dev/null >/dev/null 2>&1 &
  pid=$!
  # A fetch stopped by the terminal (one that tried to read it) only takes TERM once continued.
  { sleep "$limit"; kill -TERM -- "-$pid"; kill -CONT -- "-$pid"; } </dev/null >/dev/null 2>&1 &
  watcher=$!
  set +m
  wait "$pid" 2>/dev/null || rc=$?
  kill -- "-$watcher" 2>/dev/null || true
  wait "$watcher" 2>/dev/null || true
  [ "$rc" = 0 ] || [ $((SECONDS - start)) -lt "$limit" ] || rc=124
  return "$rc"
}

# `ramify ready`: this worktree's branch is done and waits to be merged. It brings the base in, checks that no
# branch already waiting (marked ready, mark still valid) changes the same files, and marks this one in its
# .worktree.env: WT_READY (this commit) and WT_READY_BASE (the base tip it was checked against). The mark goes
# stale by itself when either moves (`ramify ls`, READY); then run it again. Exit 1: uncommitted changes, no commits
# or an overlap, nothing marked; on an overlap it records WT_READY_WAIT (the base tip it waits at) instead, so the
# hook and the app can say when the base moves. Exit 2: the base conflicts with this branch; the merge is undone,
# the tree as it was.
cmd_ready() {
  local main here base tip branch out conflicted ahead limit rc
  main=$(main_checkout "$PWD")
  here=$(git rev-parse --show-toplevel 2>/dev/null) && here=$(cd "$here" && abspwd)
  { [ -n "$here" ] && [ "$here" != "$main" ] && [ -f "$here/.worktree.env" ]; } \
    || die "ramify ready runs in a worktree of its own, not in the main checkout"
  base=$(default_branch "$main"); [ -n "$base" ] || die "no default branch (main, master...) to get ready against"
  tip=$(git -C "$main" rev-parse -q --verify "$base^{commit}") || die "no local $base to get ready against"
  branch=$(git -C "$here" branch --show-current); branch=${branch:-HEAD}
  out=$(git -C "$here" status --porcelain)
  [ -z "$out" ] || die "uncommitted changes, nothing was marked: commit (or stash) them first"$'\n'"$out"
  [ "$(git -C "$here" rev-list --count "$tip..HEAD")" != 0 ] || die "no commits ahead of $base: nothing to merge, nothing was marked"
  # The local base is what gets merged (the app merges there), but origin is fetched so a newer one there is said
  # now: once it reaches the local base, this mark goes stale. No prompt for credentials: this may run unattended.
  if git -C "$here" remote get-url origin >/dev/null 2>&1; then
    limit=${RAMIFY_FETCH_TIMEOUT:-30}; [[ $limit =~ ^[0-9]+$ ]] || limit=30
    rc=0; fetch_base "$here" "$base" "$limit" || rc=$?
    if [ "$rc" = 0 ]; then
      ahead=$(git -C "$here" rev-list --count "$tip..refs/remotes/origin/$base" 2>/dev/null || echo 0)
      [ "$ahead" = 0 ] || log "${Y}origin/$base has $ahead commit(s) that $base does not have yet: once $base is updated, run ramify ready again${N}"
    elif [ "$rc" = 124 ]; then
      log "${Y}fetching $base from origin took more than ${limit}s and was stopped: checking against the local $base${N}"
    else
      log "${Y}could not fetch $base from origin: checking against the local $base${N}"
    fi
  fi
  # The commit read above, not the name: a base that moves meanwhile cannot slip in unchecked.
  if ! out=$(git -C "$here" merge --no-edit -m "Merge branch '$base' into $branch" "$tip" 2>&1); then
    conflicted=$(git -C "$here" diff --name-only --diff-filter=U)
    git -C "$here" merge --abort 2>/dev/null || true
    [ -n "$conflicted" ] || die "git merge $base failed, nothing was marked:"$'\n'"$out"
    log "${R}ramify:${N} $base conflicts with $branch in these files. The merge was undone and nothing was marked:"
    log "run git merge $base here, resolve them, commit, then ramify ready again."
    printf '%s\n' "$conflicted"
    exit 2
  fi
  if ! WHO_QUEUE=$tip cmd_who; then
    # Out of the queue (an earlier mark goes too), waiting at this base tip: when it moves, the turn may have come.
    env_unset "$here" WT_READY; env_unset "$here" WT_READY_BASE
    env_set "$here" WT_READY_WAIT "$tip"
    log "${Y}branches marked ready before this one change the same files: nothing was marked.${N}"
    log "Wait until they are merged (or agree with their agents or the user), then run ramify ready again."
    exit 1
  fi
  env_unset "$here" WT_READY_WAIT
  env_set "$here" WT_READY "$(git -C "$here" rev-parse HEAD)"
  env_set "$here" WT_READY_BASE "$tip"
  log "${G}ready${N} $branch: up to date with $base, no overlap with the other branches marked ready"
}

cmd_ls() {
  local json=0 main base line cur="" branch="" dirty commits sync port agent name active procs c1 c2 first=1 run sess
  local tip ready behind c3
  [ "${1:-}" = --json ] && json=1
  main=$(main_checkout "$PWD")
  # The base of `ramify who` and `ramify ready`, whatever the main checkout has checked out right now.
  base=$(default_branch "$main"); [ -n "$base" ] || base=$(git -C "$main" branch --show-current)
  tip=$(git -C "$main" rev-parse -q --verify "${base:-HEAD}^{commit}" 2>/dev/null || true)
  procs=$(active_agents)
  if [ "$json" = 1 ]; then printf '['
  else
    printf "${B}%-20s %-24s %-9s %-13s %-8s %-8s %-9s %-6s %s${N}\n" \
      WORKTREE BRANCH AGENT RUNNING CHANGES COMMITS UPSTREAM READY PORTS
  fi
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) cur=${line#worktree }; branch="" ;;
      "branch "*) branch=${line#branch refs/heads/} ;;
      "")
        if [ -n "$cur" ] && [ -d "$cur" ]; then
          dirty=$(git -C "$cur" status --porcelain | wc -l | tr -d ' ')
          if [ "$cur" = "$main" ]; then name="(main)"; commits=0
          else name=$(basename "$cur"); commits=$(git -C "$cur" rev-list --count "$base..HEAD" 2>/dev/null || echo 0); fi
          if ! git -C "$cur" rev-parse -q --verify '@{u}' >/dev/null 2>&1; then sync=local
          else sync=$(git -C "$cur" rev-list --count '@{u}..HEAD'); [ "$sync" = 0 ] && sync=pushed || sync="+$sync"; fi
          # Commits of the base the branch does not have, and its place in the merge queue (see ramify ready).
          ready=""; behind=0
          if [ "$cur" != "$main" ] && [ -n "$tip" ]; then
            behind=$(git -C "$cur" rev-list --count "HEAD..$tip" 2>/dev/null || echo 0)
            ready=$(ready_state "$cur" "$tip")
          fi
          port=$(env_get "$cur" PORT); agent=$(env_get "$cur" WT_AGENT)
          # .worktree.env can come from the repository itself (a clone that ships one): a port is digits or nothing,
          # never text that bash arithmetic or the JSON below would run or splice in.
          [[ $port =~ ^[0-9]{1,5}$ ]] || port=""
          active=$(agents_in "$procs" "$cur" "$agent")
          if [ "$json" = 1 ]; then
            [ "$first" = 1 ] || printf ','; first=0
            run=""
            if [ -n "$active" ]; then
              run=$(printf '%s\n' "$active" | tr ',' '\n' | while IFS= read -r x; do json_str "$x"; printf ','; done)
              run=${run%,}
            fi
            # The conversation whose subagent made it (ramify hook create records WT_SESSION), when there is one.
            sess=$(env_get "$cur" WT_SESSION); [ -z "$sess" ] || sess=",\"session\":$(json_str "$sess")"
            printf '{"name":%s,"path":%s,"branch":%s,"main":%s,"agent":%s,"running":[%s],"changes":%s,"commits":%s,"behind":%s,"upstream":%s,"ready":%s,"port":%s%s}' \
              "$(json_str "$name")" "$(json_str "$cur")" "$(json_str "$branch")" \
              "$([ "$cur" = "$main" ] && echo true || echo false)" "$(json_str "$agent")" "$run" \
              "$dirty" "${commits:-0}" "${behind:-0}" "$(json_str "$sync")" "$([ -n "$ready" ] && json_str "$ready" || echo null)" "${port:-null}" "$sess"
          else
            if [ "$cur" = "$main" ]; then commits=-; fi
            if [ "$dirty" = 0 ]; then c1=$D; else c1=$Y; fi
            if [ -n "$active" ]; then c2=$G; else c2=$D; active=-; fi
            case "$ready" in ready) c3=$G ;; stale) c3=$Y ;; waiting) c3=$Y; ready='wait' ;; *) c3=$D; ready=- ;; esac
            printf -v dirty '%-8s' "$dirty"; printf -v active '%-13s' "$active"; printf -v ready '%-6s' "$ready"
            printf "%-20s ${M}%-24s${N} %-9s ${c2}%s${N} ${c1}%s${N} %-8s %-9s ${c3}%s${N} %s\n" "$name" "${branch:-(detached)}" \
              "${agent:--}" "$active" "$dirty" "$commits" "$sync" "$ready" "${port:+$port-$((port + PORT_BLOCK - 1))}"
          fi
        fi
        cur="" ;;
    esac
  done < <(git -C "$main" worktree list --porcelain; echo)
  if [ "$json" = 1 ]; then printf ']\n'; fi
}

cmd_graph() {
  local main n=40 refs line agent b cur=""
  [ "${1:-}" = -n ] && n=$2
  main=$(main_checkout "$PWD")
  refs=$(git -C "$main" worktree list --porcelain | sed -n 's#^branch refs/heads/##p')
  [ -n "$refs" ] || die "no branches checked out"
  log "${B}agents:${N}"
  while IFS= read -r line; do
    case "$line" in "worktree "*) cur=${line#worktree } ;; "branch "*)
      b=${line#branch refs/heads/}; agent=$(env_get "$cur" WT_AGENT)
      [ "$cur" = "$main" ] && agent="(main checkout)"
      log "  ${M}$b${N}  ${agent:-${D}no agent recorded${N}}" ;;
    esac
  done < <(git -C "$main" worktree list --porcelain)
  log ""
  # shellcheck disable=SC2086
  git -C "$main" log --graph --color=always --date-order -n "$n" \
    --format='%C(auto)%h%d %s %C(dim)%cr%C(reset)' $refs
}

# Remove a worktree. Never deletes a branch with unmerged commits: it is kept.
# squashed: the commit a merged pull request had as its head (the caller asked GitHub). A squash merge leaves
# the branch out of the base's history, so the branch goes too, but only while its tip is still that commit.
remove_wt() {
  local main="$1" wt="$2" force="$3" squashed="${4:-}" branch
  [ -n "$wt" ] && [ -d "$wt" ] || die "no such worktree: '$wt'"
  [ "$wt" != "$main" ] || die "that is the main checkout"
  branch=$(git -C "$wt" branch --show-current 2>/dev/null || true)
  if [ "$force" != 1 ]; then
    [ -z "$(git -C "$wt" status --porcelain)" ] \
      || die "uncommitted changes in $wt (--force discards them)"
    local gitdir head
    gitdir=$(git -C "$wt" rev-parse --absolute-git-dir 2>/dev/null || true)
    if [ -n "$gitdir" ] && { [ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ]; }; then
      die "a rebase is in progress in $wt (finish or abort it, or use --force)"
    fi
    if [ -z "$branch" ]; then
      head=$(git -C "$wt" rev-parse HEAD 2>/dev/null || true)
      if [ -n "$head" ] && [ -z "$(git -C "$main" for-each-ref --contains "$head" refs/heads refs/remotes 2>/dev/null)" ]; then
        die "detached HEAD with commits on no branch in $wt (create a branch for them, or use --force)"
      fi
    fi
    if [ -n "$squashed" ] && [ "$(git -C "$main" rev-parse --verify --quiet "refs/heads/$branch")" != "$squashed" ]; then
      die "branch $branch has moved since its pull request was merged (--force removes the worktree and keeps the branch)"
    fi
    if [ -n "$branch" ] && [ -z "$squashed" ] && ! git -C "$main" merge-base --is-ancestor "$branch" HEAD \
       && [ "$(git -C "$wt" rev-list --count '@{u}..HEAD' 2>/dev/null || echo x)" != 0 ]; then
      die "branch $branch has commits that are neither merged nor pushed (--force removes the worktree and keeps the branch)"
    fi
  fi
  run_project_script "$wt" "$main" teardown || true
  if [ "$force" = 1 ]; then git -C "$main" worktree remove --force "$wt" >&2
  else git -C "$main" worktree remove "$wt" >&2; fi
  rm -rf "$ROOT/$(basename "$main")/.derived-data/$(basename "$wt")"
  # The worktree goes first: git refuses to delete a branch still checked out in one.
  if [ -n "$branch" ]; then
    if [ -n "$squashed" ] && [ "$force" != 1 ]; then
      git -C "$main" branch -D "$branch" >/dev/null 2>&1 && log "${D}branch $branch deleted (its pull request was merged)${N}"
    elif git -C "$main" merge-base --is-ancestor "$branch" HEAD; then
      git -C "$main" branch -d "$branch" >/dev/null 2>&1 && log "${D}branch $branch deleted (already merged)${N}"
    else
      log "${Y}branch $branch kept (has commits not in $(git -C "$main" branch --show-current))${N}"
    fi
  fi
  log "${R}-${N} $wt"
}

cmd_prune() {
  local main repo wt branch procs n=0
  main=$(main_checkout "$PWD"); repo=$(basename "$main")
  procs=$(active_agents)
  for wt in "$ROOT/$repo"/*/; do
    wt=${wt%/}
    [ -f "$wt/.worktree.env" ] || continue
    of_repo "$wt" "$main" || continue
    [ -z "$(git -C "$wt" status --porcelain 2>/dev/null)" ] || continue
    branch=$(git -C "$wt" branch --show-current 2>/dev/null || true)
    [ -n "$branch" ] && git -C "$main" merge-base --is-ancestor "$branch" HEAD || continue
    # A branch that never got a commit of its own is new work in progress, not finished work.
    [ "$(git -C "$main" reflog show --format=%H "refs/heads/$branch" 2>/dev/null | wc -l | tr -d ' ')" -gt 1 ] || continue
    if printf '%s\n' "$procs" | awk -F'\t' -v p="$wt" '$1 == p || index($1, p "/") == 1 { f = 1 } END { exit !f }'; then
      log "${D}kept $wt: an agent is working in it${N}"; continue
    fi
    remove_wt "$main" "$wt" 0; n=$((n + 1))
  done
  log "$n clean, merged worktree(s) removed"
}

cmd_ui() {
  local main port=0 open_browser=1 token
  while [ $# -gt 0 ]; do
    case "$1" in
      --port) port=$2; shift 2 ;;
      --no-open) open_browser=0; shift ;;
      *) die "usage: ramify ui [--port N] [--no-open]" ;;
    esac
  done
  command -v python3 >/dev/null || die "python3 is required for the dashboard"
  main=$(main_checkout "$PWD")
  token=$(python3 -I -c 'import secrets; print(secrets.token_hex(16))')
  if [ -f "$SELF_DIR/ui/server.py" ]; then cd "$SELF_DIR/ui"
  elif [ -f "$SELF_DIR/../ui/server.py" ]; then cd "$SELF_DIR/../ui"
  else die "dashboard files not found next to $SELF_DIR"; fi
  RAMIFY_UI_TOKEN=$token python3 -I server.py --main "$main" --bin "$SELF_DIR/ramify" --port "$port" \
    | while IFS= read -r url; do
        log "${B}ramify ui${N}  $url  ${D}(Ctrl-C to stop)${N}"
        if [ "$open_browser" = 1 ]; then
          if [ "$(uname)" = Darwin ]; then open "$url"
          elif [ -n "${MSYSTEM:-}" ]; then cmd.exe //c start "" "$url"
          elif command -v xdg-open >/dev/null; then xdg-open "$url" >/dev/null 2>&1; fi
        fi
      done
}

# Open the desktop app on this repository (or worktree) through its ramify:// link.
cmd_app() {
  local dir url
  dir=$(abspwd)
  main_checkout "$dir" >/dev/null
  url="ramify://open?path=$(printf '%s' "$dir" | jq -sRr @uri 2>/dev/null || python3 -I -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1]))' "$dir")"
  if [ -n "${MSYSTEM:-}" ]; then cmd.exe //c start "" "$url"; return; fi
  [ "$(uname)" = Darwin ] || die "the desktop app is for macOS and Windows; use: ramify ui"
  open -Ra ramify 2>/dev/null || die "ramify.app is not installed (see apps/desktop in the repository)"
  open "$url"
}

# On the default branch of a main checkout, unless the repository allows it (git config ramify.allowMain true)
# or the session does (RAMIFY_ALLOW_MAIN=1). Prints the branch when it is the shared one.
shared_branch_at() {
  local dir="$1" top main branch
  [ -n "${RAMIFY_ALLOW_MAIN:-}" ] && return 1
  while [ ! -d "$dir" ] && [ "$dir" != / ]; do dir=$(dirname "$dir"); done
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || return 1
  main=$(main_checkout "$dir" 2>/dev/null) || return 1
  [ "$(cd "$top" && abspwd)" = "$main" ] || return 1
  [ "$(git -C "$main" config --bool ramify.allowMain 2>/dev/null)" = true ] && return 1
  branch=$(git -C "$main" branch --show-current)
  [ -n "$branch" ] && [ "$branch" = "$(default_branch "$main")" ] || return 1
  printf '%s' "$branch"
}

# The git commands of a terminal line ($1, run from the folder $2), one per line, fields separated by \037 (not a
# tab: read would merge empty fields between tabs):
#   <subcommand> <folder> <unknown> <abort> <hard> <refs> <options> <arguments>
# <folder> is where each one runs: its -C folder, else the last `cd <dir>` before it, else $2. git counts by
# any path (/usr/bin/git) and after global options (-c k=v, -P, --no-pager…). Quotes are honoured, so a commit
# message that mentions git is no git command, and `bash -c "…"` is read as the line it runs. A folder named
# by a variable or a command ($WT_PATH, $(…)) cannot be known here: the folder before it stays and <unknown>
# is 1. <abort> is 1 with --abort or --quit, <hard> with --hard. <refs>: for push, the branches it updates
# on the remote ("@" the current one, "*" all of them); for pull, the branches it brings in. <options> and
# <arguments> are the subcommand's other words, space separated. Only git in command position counts: at the start
# of the line or after ; && || | ( $( or a backtick, after env, command, time, nohup, xargs, sudo, exec and VAR=x,
# and the line an eval runs. Writes to files that do not go through git (> a.txt, sed -i, tee) are not judged.
git_calls() {
  printf '%s' "$1" | awk -v cwd="$2" -v home="$HOME" '
    function add(w, sep, cmd) { n++; W[n] = w; S[n] = sep; C[n] = cmd }
    # A command ends: the next word is in command position again. An eval of this depth or above ends with it.
    function cut(depth) { if (n && !S[n]) add("", 1, 0); start = 1; prefix = 0; if (ev && depth <= evd) ev = 0 }
    function word(w, depth) {
      # The words of `eval` (and of `bash -c`) are read as the line they run.
      if (ev && depth == evd) { line(w, depth + 1); return }
      if (depth < 3 && shell && n && !S[n] && W[n] ~ /^-[A-Za-z]*c$/) { cut(depth); line(w, depth + 1); cut(depth); return }
      if (start) {
        # Before the command: assignments (VAR=x), the commands that run another (env, sudo…) with their options,
        # and the shell words after which a command follows (if, then, !…).
        if (w ~ /^[A-Za-z_][A-Za-z0-9_]*=/ || (prefix && w ~ /^-/)) { add(w, 0, 0); return }
        if (w ~ /^(env|command|time|nohup|xargs|sudo|exec|builtin|nice)$/) { prefix = 1; add(w, 0, 0); return }
        if (w ~ /^(if|then|else|elif|do|while|until|!|\{)$/) { add(w, 0, 0); return }
        start = 0; shell = (w ~ /(^|\/)(ba|z|da|k)?sh$/)
        if (w == "eval" && depth < 3) { ev = 1; evd = depth; start = 1; prefix = 0; return }
        add(w, 0, 1); return
      }
      add(w, 0, 0)
    }
    # Words and command separators of a shell line, without its quotes.
    function line(s, depth,    i, len, c, w, has, rest, j) {
      len = length(s); w = ""; has = 0
      for (i = 1; i <= len; i++) {
        c = substr(s, i, 1)
        if (c == "\047") {
          rest = substr(s, i + 1); j = index(rest, "\047"); if (!j) j = length(rest) + 1
          w = w substr(rest, 1, j - 1); i += j; has = 1
        } else if (c == "\"") {
          for (i++; i <= len && substr(s, i, 1) != "\""; i++) {
            if (substr(s, i, 1) == "\\" && i < len) i++
            w = w substr(s, i, 1)
          }
          has = 1
        } else if (c == "\\" && i < len) {
          i++; if (substr(s, i, 1) != "\n") { w = w substr(s, i, 1); has = 1 }
        } else if (c == " " || c == "\t") {
          if (has) word(w, depth); w = ""; has = 0
        } else if (index(";&|()\n`", c)) {
          if (has) word(w, depth); w = ""; has = 0; cut(depth)
        } else { w = w c; has = 1 }
      }
      if (has) word(w, depth)
    }
    function resolve(base, d) {
      if (d ~ /[$`]/ || d == "-") return ""
      if (d == "~") return home
      if (substr(d, 1, 2) == "~/") return home substr(d, 2)
      if (d ~ /^\// || d ~ /^[A-Za-z]:/) return d
      return base "/" d
    }
    # The branch a refspec updates (push) or brings in (pull).
    function ref(verb, r,    i) {
      gsub(/[\t\n]/, " ", r); sub(/^\+/, "", r); i = index(r, ":")
      if (verb == "push") { if (i) r = substr(r, i + 1); else if (r == "HEAD" || r == "@") r = "@" }
      else if (i) r = substr(r, 1, i - 1)
      sub(/^refs\/heads\//, "", r)
      return r == "" ? "*" : r
    }
    { text = text (NR > 1 ? "\n" : "") $0 }
    END {
      start = 1; line(text, 0)
      dir = cwd; unknown = 0
      for (k = 1; k <= n; k++) {
        # Only a word in command position runs: `echo use git commit` runs echo.
        if (S[k] || !C[k]) continue
        w = W[k]
        if (w == "cd" || w == "pushd") {
          t = (k < n && !S[k + 1]) ? W[++k] : "~"
          r = resolve(dir, t); if (r == "") unknown = 1; else dir = r
          continue
        }
        if (w !~ /^([^ ]*\/)?git$/) continue
        gdir = dir; gunknown = unknown
        for (k++; k <= n && !S[k]; k++) {
          a = W[k]
          if (a == "-C" && k < n && !S[k + 1]) { r = resolve(gdir, W[++k]); if (r == "") gunknown = 1; else gdir = r }
          else if ((a == "-c" || a == "--git-dir" || a == "--work-tree" || a == "--namespace") && k < n && !S[k + 1]) k++
          else if (a !~ /^-/) break
        }
        if (k > n || S[k]) { k--; continue }
        verb = W[k]; abort = 0; hard = 0; all = 0; tags = 0; pos = 0; refs = ""; fl = ""; ar = ""
        for (k++; k <= n && !S[k]; k++) {
          a = W[k]
          if (a == "--abort" || a == "--quit") abort = 1
          else if (a == "--hard") hard = 1
          else if (a == "--all" || a == "--mirror" || a == "--branches") all = 1
          else if (a == "--tags") tags = 1
          else if (a ~ /^-/) fl = fl " " a
          else if (a ~ /^[0-9]*[<>]/) { if (a ~ /^[0-9]*[<>]+&?$/ && k < n && !S[k + 1]) k++ }
          else { ar = ar " " a; if (++pos > 1) refs = refs " " ref(verb, a) }
        }
        k--
        if (verb == "push" && all) refs = refs " *"
        if (verb == "push" && pos <= 1 && !all && !tags) refs = refs " @"
        gsub(/[\037\n]/, " ", verb); gsub(/[\037\n]/, " ", gdir); gsub(/[\037\n]/, " ", fl); gsub(/[\037\n]/, " ", ar)
        printf "%s\037%s\037%d\037%d\037%d\037%s\037%s\037%s\n", verb, gdir, gunknown, abort, hard, substr(refs, 2), substr(fl, 2), substr(ar, 2)
      }
    }'
}

# The default branch of the repository at $1 while it is protected: not when the session allows changing it
# (RAMIFY_ALLOW_MAIN=1) or the repository does (git config ramify.allowMain true). Fails outside a repository.
protected_branch() {
  local dir="$1" main
  [ -n "${RAMIFY_ALLOW_MAIN:-}" ] && return 1
  while [ ! -d "$dir" ] && [ "$dir" != / ]; do dir=$(dirname "$dir"); done
  main=$(main_checkout "$dir" 2>/dev/null) || return 1
  [ "$(git -C "$main" config --bool ramify.allowMain 2>/dev/null)" = true ] && return 1
  default_branch "$main"
}

# Why a terminal line ($1, run from $2) must not run, if it must not: the first of its git commands that would
# change the shared branch. On it, in the main checkout: commit, merge, cherry-pick, revert, am, rebase,
# reset --hard, a pull of another branch, git branch -m/-M renaming it, git update-ref HEAD. From anywhere: a push
# that updates the default branch, git update-ref of it, git branch -f/-m/-M/-C onto or of it, git checkout -B
# or git switch -C of it. fetch and pull --ff-only of the branch itself stay allowed. Prints nothing when the
# line may run.
git_refusal() {
  local verb dir unknown abort hard refs opts args b what cur first
  while IFS=$'\037' read -r verb dir unknown abort hard refs opts args; do
    b=""; what=""; first=${args%% *}
    case "$verb" in
      update-ref)
        # git update-ref [-d] refs/heads/main …, or HEAD while main is checked out.
        b=$(protected_branch "$dir") && [ -n "$b" ] || continue
        case "$first" in
          "refs/heads/$b") what="git update-ref" ;;
          HEAD) shared_branch_at "$dir" >/dev/null && what="git update-ref" ;;
        esac ;;
      branch)
        b=$(protected_branch "$dir") && [ -n "$b" ] || continue
        case " $opts " in
          *" -m "*|*" -M "*|*" --move "*)
            # Renamed (git branch -M main x), overwritten (git branch -M x main), or the one checked out renamed
            # (git branch -M x on main in the main checkout).
            case " $args " in *" $b "*) what="git branch $opts" ;; esac
            case "$args" in *" "*) ;; *) if [ -z "$what" ] && shared_branch_at "$dir" >/dev/null; then what="git branch $opts"; fi ;; esac ;;
          *" -C "*)
            # A copy onto it overwrites it: git branch -C x main.
            case "$args" in *" $b") what="git branch $opts" ;; esac ;;
          *" -f "*|*" --force "*)
            # Moved to another commit: git branch -f main HEAD.
            [ "$first" != "$b" ] || what="git branch $opts" ;;
        esac ;;
      checkout|switch)
        # Reset to a start point (HEAD by default): git checkout -B main, git switch -C main.
        case " $opts " in *" -B "*|*" -C "*|*" --force-create "*) ;; *) continue ;; esac
        b=$(protected_branch "$dir") && [ -n "$b" ] || continue
        [ "$first" != "$b" ] || what="git $verb $opts" ;;
      commit) b=$(shared_branch_at "$dir") && what=commit ;;
      merge|cherry-pick|revert|am|rebase) [ "$abort" = 1 ] || { b=$(shared_branch_at "$dir") && what="git $verb"; } ;;
      reset) [ "$hard" = 0 ] || { b=$(shared_branch_at "$dir") && what="git reset --hard"; } ;;
      pull)
        b=$(shared_branch_at "$dir") || continue
        # Bringing in another branch (git pull origin feat/x) is a merge into the shared branch.
        [ -z "$(printf '%s' "$refs" | tr ' ' '\n' | grep -vxF -e "$b" -e '')" ] || what="git pull" ;;
      push)
        b=$(protected_branch "$dir") && [ -n "$b" ] || continue
        case " $refs " in *" $b "*|*" * "*) what=push ;; esac
        case " $refs " in *" @ "*)
          cur=$(git -C "$dir" branch --show-current 2>/dev/null) || cur=""
          [ "$cur" != "$b" ] || what=push ;;
        esac ;;
    esac
    [ -n "$what" ] || continue
    # cd "$WT_PATH" && git commit: the variable may well name a worktree, but this check cannot know it.
    if [ "$unknown" = 1 ]; then
      printf '%s' "This command runs git $verb in a folder named by a variable or a command (such as cd \"\$WT_PATH\"), which this check cannot resolve, so it is judged by the folder the command starts in: there it would change $b, the shared branch. Write the folder as a literal path (cd /path/to/your/worktree && git $verb ...) or use git -C /path/to/your/worktree $verb ..."
    elif [ "$what" = commit ]; then
      printf '%s' "This commit would land on $b, the shared branch. Call the EnterWorktree tool first with a short conventional name for the task (feat-..., fix-...), make the change there and commit in that worktree. (To allow commits on $b in this repository the user runs: git config ramify.allowMain true)"
    elif [ "$what" = push ]; then
      printf '%s' "This push would update $b, the shared branch, on the remote. Push the branch of your own instead (git push -u origin <your branch>); bringing it into $b is for the user to do (from the Ramify app, for one). (To allow pushes to $b in this repository the user runs: git config ramify.allowMain true)"
    else
      printf '%s' "$what here would change $b, the shared branch, which only the user changes. Make changes in a worktree of your own (call the EnterWorktree tool with a short conventional name, feat-... or fix-...); when a branch is ready, tell the user: merging it into $b is theirs to do (from the Ramify app, for one). (To allow this on $b in this repository the user runs: git config ramify.allowMain true)"
    fi
    return 0
  done < <(git_calls "$1" "$2")
  return 0
}

# jq, unless RAMIFY_NO_JQ=1 makes ramify act as if it were missing (for the tests).
have_jq() { [ -z "${RAMIFY_NO_JQ:-}" ] && command -v jq >/dev/null; }

# A string of the hook's JSON ($1) at a path such as .tool_input.command, or nothing. Without jq a minimal reader
# finds the key by its last name ("command": "...", after { or ,) and decodes the usual escapes; a value with a \u
# escape, or no string at all, reads as nothing.
hook_field() {
  if have_jq; then printf '%s' "$1" | jq -r "$2 | strings"; return; fi
  printf '%s' "$1" | awk -v key="${2##*.}" '
    { s = s $0 "\n" }
    END {
      if (!match(s, "[{,][ \t\r\n]*\"" key "\"[ \t\r\n]*:[ \t\r\n]*\"")) exit
      out = ""
      for (i = RSTART + RLENGTH; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "\"") { printf "%s", out; exit }
        if (c != "\\") { out = out c; continue }
        c = substr(s, ++i, 1)
        if (c == "n") out = out "\n"; else if (c == "t") out = out "\t"; else if (c == "r") out = out "\r"
        else if (c == "b") out = out "\b"; else if (c == "f") out = out "\f"
        else if (c == "\"" || c == "\\" || c == "/") out = out c
        else exit
      }
    }'
}

# The PreToolUse answer that refuses the tool call, with the reason ($1) Claude reads.
hook_deny() {
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":%s}}\n' "$(json_str "$1")"
}

cmd_hook() {
  local input name cwd wt main branch file slug repo session base n owner dir cmd why msg ctx
  # Hooks never get in the way when they cannot run. Without jq: session-start says so and guard reads its input
  # with a minimal reader; nudge stays quiet, and create and remove need it.
  if ! have_jq; then
    case "${1:-}" in session-start|guard) ;; nudge) exit 0 ;; *) die "jq is required for hook mode" ;; esac
  fi
  input=$(cat)
  case "${1:-}" in
    create)
      name=$(printf '%s' "$input" | jq -r '.name')
      cwd=$(printf '%s' "$input" | jq -r '.cwd')
      session=$(printf '%s' "$input" | jq -r '.session_id // empty')
      cd "$cwd"
      # feat-login → feat/login; anything else keeps the worktree- prefix.
      case "$name" in
        feat-*|fix-*|docs-*|refactor-*|test-*|chore-*|perf-*) base="${name%%-*}/${name#*-}" ;;
        *) base="worktree-$name" ;;
      esac
      main=$(main_checkout "$PWD"); repo=$(basename "$main")
      mkdir -p "$ROOT/$repo/.claims"
      # The same name again from the same conversation (a resumed session) reuses its worktree. Another
      # conversation that picks the same name gets the next free one (feat/login-2), never a folder
      # someone else works in. A worktree without a recorded conversation is reused, as before.
      n=1; branch=$base
      while :; do
        slug=$(slugify "$branch"); dir="$ROOT/$repo/$slug"
        # A claim whose conversation's ramify is gone (killed before its trap ran) frees its name again.
        [ ! -e "$ROOT/$repo/.claims/$slug" ] || reclaim_stale "$ROOT/$repo/.claims/$slug" || true
        if [ -d "$dir" ] && [ -e "$ROOT/$repo/.claims/$slug" ]; then
          :  # still being made for another conversation (git worktree add, then npm ci…): taken
        elif [ -d "$dir" ]; then
          owner=$(env_get "$dir" WT_SESSION)
          # A worktree of another repository with the same folder name is taken, whoever made it.
          if of_repo "$dir" "$main" && { [ -z "$session" ] || [ -z "$owner" ] || [ "$owner" = "$session" ]; }; then
            (cd "$dir" && abspwd); exit 0
          fi
        elif (set -C; printf '%s\n' "$$" > "$ROOT/$repo/.claims/$slug") 2>/dev/null; then
          # Claimed: two conversations starting at once cannot both take this name. A file made with noclobber
          # (O_EXCL, from bash itself), not mkdir: uutils mkdir can tell two callers that each made the folder.
          # It holds this ramify's pid, so a claim left by one that was killed can be taken back.
          break
        fi
        n=$((n + 1)); branch="$base-$n"
      done
      # The claim goes when this ends, also when create stops: a failed name must not stay reserved.
      # (The path is fixed now: these variables are local and gone by the time the script exits.)
      # shellcheck disable=SC2064
      trap "rm -f -- $(printf '%q' "$ROOT/$repo/.claims/$slug")" EXIT
      CREATE_SESSION=$session create "$branch" "" 1 claude
      printf '%s\n' "$CREATED_WT" ;;
    remove)
      wt=$(printf '%s' "$input" | jq -r '.worktree_path')
      [ -d "$wt" ] || exit 0
      main=$(main_checkout "$wt")
      # Claude Code already asked for confirmation: discard changes, but keep the branch.
      remove_wt "$main" "$wt" 1 ;;
    nudge)
      # On every prompt (UserPromptSubmit): a branch marked ready, or waiting for its turn, whose base moved since
      # hears it in its next turn. Quiet everywhere else, and it never blocks the prompt.
      local tip state why
      cwd=$(printf '%s' "$input" | jq -r '.cwd // empty')
      wt=$(git -C "${cwd:-$PWD}" rev-parse --show-toplevel 2>/dev/null) || exit 0
      [ -f "$wt/.worktree.env" ] || exit 0
      main=$(main_checkout "$wt" 2>/dev/null) || exit 0
      base=$(default_branch "$main"); [ -n "$base" ] || exit 0
      tip=$(git -C "$main" rev-parse -q --verify "$base^{commit}" 2>/dev/null) || exit 0
      state=$(ready_state "$wt" "$tip")
      case "$state" in stale|waiting) ;; *) exit 0 ;; esac
      # Stale only because of its own new commits: the agent made them and knows; nothing to say. A waiting branch
      # lacks base commits only once the base moved past the tip it waits at.
      n=$(git -C "$wt" rev-list --count "HEAD..$tip" 2>/dev/null || echo 0)
      [ "$n" != 0 ] || exit 0
      branch=$(git -C "$wt" branch --show-current); branch=${branch:-this branch}
      if [ "$state" = waiting ]; then
        why="$branch was waiting for its turn: a branch marked ready before it changes the same files. $base has moved since ($n commit(s) $branch does not have yet), so what it waited for may be merged now."
      else
        why="$base has moved since $branch was marked ready to merge ($n commit(s) it does not have yet)."
      fi
      jq -n --arg b "$base" --arg why "$why" --arg bin "$(cd "$SELF_DIR" && pwd)/ramify" \
        '{hookSpecificOutput: {hookEventName: "UserPromptSubmit", additionalContext:
        ("ramify: " + $why + " "
        + "Run `\"" + $bin + "\" ready` again in this worktree before asking for the merge: it brings " + $b + " in, checks "
        + "the other branches marked ready and marks this one. Exit 1: another ready branch changes the same files; "
        + "exit 2: " + $b + " conflicts with this branch (the files are listed): merge " + $b + ", resolve and commit, then run it again.")}}' ;;
    session-start)
      # A session that opens on the shared branch learns to take a worktree of its own before changing files.
      cwd=$(hook_field "$input" .cwd)
      if branch=$(shared_branch_at "${cwd:-$PWD}"); then
        msg="ramify: this session is on $branch, the shared branch. Changes will go to a branch and folder of their own."
        ctx="This session starts in the main checkout on $branch, the shared branch other agents and the user work from. Before you change any file, call the EnterWorktree tool with a short conventional name for the task, such as feat-login or fix-cart-total: ramify creates a branch and a folder of its own, with the ignored files, dependencies and ports the project needs, and you continue there. Reading code and answering questions do not need it."
      else
        msg=""; ctx=""
      fi
      # Without jq the protection is partial: the user hears it at every session, wherever it starts.
      if ! have_jq; then
        msg="ramify: jq is not installed, so the protection of the shared branch is partial and EnterWorktree cannot create worktrees. Install jq (brew install jq, apt install jq).${ctx:+ This session is on $branch, the shared branch.}"
        [ -z "$ctx" ] || ctx="${ctx%% Before you change *} jq is not installed, so EnterWorktree fails here: before you change any file, run \"$(cd "$SELF_DIR" && pwd)/ramify\" new <branch> --no-launch (branch such as feat/login) and work in the folder it prints, and ask the user to install jq. Reading code and answering questions do not need it."
      fi
      [ -n "$msg" ] || exit 0
      [ -z "$ctx" ] || ctx="$ctx Edits on $branch are blocked unless the user runs: git config ramify.allowMain true"
      # additionalContext reaches only Claude; systemMessage is the line the user sees.
      printf '{"systemMessage":%s' "$(json_str "$msg")"
      [ -z "$ctx" ] || printf ',"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":%s}' "$(json_str "$ctx")"
      printf '}\n' ;;
    guard)
      # A terminal command that would change the shared branch (a commit, a merge… on it, a push to it) is
      # refused like an edit.
      cmd=$(hook_field "$input" .tool_input.command)
      if [ -n "$cmd" ] && printf '%s' "$cmd" | grep -Eiq 'ramify\.allowmain'; then
        hook_deny "ramify.allowMain is for the user to set: it turns off the protection of the shared branch."
        exit 0
      fi
      if [ -n "$cmd" ]; then
        cwd=$(hook_field "$input" .cwd)
        why=$(git_refusal "$cmd" "${cwd:-$PWD}")
        [ -z "$why" ] || hook_deny "$why"
        exit 0
      fi
      # Edits on the shared branch are refused with the way out: a worktree of its own.
      file=$(hook_field "$input" .tool_input.file_path)
      [ -n "$file" ] || file=$(hook_field "$input" .tool_input.notebook_path)
      [ -n "$file" ] || exit 0
      case "$file" in /*|[A-Za-z]:*) ;; *) file="$(hook_field "$input" .cwd)/$file" ;; esac
      # Inside .git (its config, its hooks) git cannot tell the branch: judge by the checkout that owns it.
      case "$file" in */.git/*) file="${file%%/.git/*}/.git" ;; esac
      branch=$(shared_branch_at "$(dirname "$file")") || exit 0
      hook_deny "This file is on $branch, the shared branch. Call the EnterWorktree tool first with a short conventional name for the task (feat-..., fix-...): you get a branch and folder of your own, then make the change there. (To allow edits on $branch in this repository the user runs: git config ramify.allowMain true)" ;;
    *) die "usage: ramify hook create|remove|session-start|guard|nudge" ;;
  esac
}

# A copy of $1 as it was before ramify first changed it: an existing one is never overwritten.
backup_once() { [ ! -f "$1" ] || [ -e "$1.bak-ramify" ] || cp "$1" "$1.bak-ramify"; }

# A Claude Code hook entry that runs ramify (any path to it, quoted or not), as jq: the ones install replaces.
RAMIFY_HOOK_JQ='def ramify_hook: [.hooks[]?.command // "" | test("ramify[\"'"'"']?\\s+hook\\s")] | any;'

# Rewrite the JSON file $1 with jq and the other arguments, through a temporary file: a failure leaves it as it was.
jq_in_place() {
  local f="$1"; shift
  if ! jq "$@" "$f" > "$f.ramify-tmp" || ! mv "$f.ramify-tmp" "$f"; then rm -f "$f.ramify-tmp"; die "could not update $f"; fi
}

install_claude_hooks() {
  local f="$HOME/.claude/settings.json" bin
  command -v jq >/dev/null || die "jq is required"
  bin=$(cd "$SELF_DIR" && pwd)/ramify
  mkdir -p "$HOME/.claude"; [ -f "$f" ] || echo '{}' > "$f"
  backup_once "$f"
  # Only ramify's own entries are replaced: other hooks on these events stay.
  jq_in_place "$f" --arg c "$bin hook create" --arg r "$bin hook remove" "$RAMIFY_HOOK_JQ"'
    def put($cmd): [(. // [])[] | select(ramify_hook | not)] + [{hooks: [{type: "command", command: $cmd}]}];
    .hooks = (.hooks // {}) | .hooks.WorktreeCreate |= put($c) | .hooks.WorktreeRemove |= put($r)'
  log "${G}+${N} Claude Code hooks in $f (backup: $f.bak-ramify)"
}

# The Claude Code plugin from the marketplace next to this script: the repository (.claude-plugin/) or the
# app bundle (Resources/claude-marketplace). The plugin brings the hooks, so the ones claude-hooks wrote go.
install_claude_plugin() {
  local market f="$HOME/.claude/settings.json"
  command -v claude >/dev/null || die "claude is not installed (or not on PATH)"
  if [ -f "$SELF_DIR/.claude-plugin/marketplace.json" ]; then market=$SELF_DIR
  elif [ -f "$SELF_DIR/../claude-marketplace/.claude-plugin/marketplace.json" ]; then market=$(cd "$SELF_DIR/../claude-marketplace" && pwd)
  else die "no Claude Code marketplace next to $SELF_DIR"; fi
  claude plugin marketplace add "$market" >/dev/null || die "claude plugin marketplace add $market failed"
  claude plugin install ramify@ramify >/dev/null || die "claude plugin install ramify@ramify failed"
  log "${G}+${N} Claude Code plugin ramify@ramify (from $market)"
  if [ -f "$f" ] && command -v jq >/dev/null && jq -e '[.hooks // {} | .[][]? | .hooks[]?.command // "" | select(test("ramify[\"'"'"']?\\s+hook\\s"))] | length > 0' "$f" >/dev/null 2>&1; then
    backup_once "$f"
    jq_in_place "$f" "$RAMIFY_HOOK_JQ"'.hooks |= with_entries(.value as $was | .value |= map(select(ramify_hook | not))
                               | select((.value | length > 0) or ($was | length == 0)))
        | if .hooks == {} then del(.hooks) else . end'
    log "${G}-${N} older ramify hooks in $f: the plugin has them now (backup: $f.bak-ramify)"
  fi
}

# The secret scan as this repository's pre-commit and pre-push hooks (shared by all its worktrees).
# A hook that is not ramify's is left alone; ramify's own is updated.
install_secrets() {
  local src="$SELF_DIR/snippets/git-hooks/ramify-secrets" dir h
  [ -f "$src" ] || die "missing $src"
  git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository: $PWD"
  [ -z "$(git config --get core.hooksPath)" ] || die "core.hooksPath is set ($(git config --get core.hooksPath)): add $src to those hooks as pre-commit and pre-push"
  dir=$(git rev-parse --path-format=absolute --git-path hooks)
  mkdir -p "$dir"
  for h in pre-commit pre-push; do
    if [ -e "$dir/$h" ] && ! grep -q '^# ramify: secret scan' "$dir/$h"; then
      log "${Y}! $dir/$h exists and is not ramify's: left as it is (call $src from it)${N}"
      continue
    fi
    cp "$src" "$dir/$h" && chmod +x "$dir/$h"
    log "${G}+${N} $dir/$h"
  done
  command -v gitleaks >/dev/null || log "${Y}gitleaks is not installed: the hooks warn but check nothing until it is (brew install gitleaks)${N}"
}

# The default branch kept for the user also from agents without Ramify's own hooks (Codex, Gemini, Cursor…): with
# ramify.guardMain, the pre-commit and pre-push hooks of install_secrets refuse a commit on it in the main checkout
# and a push to it. The app's merges run without hooks, so they still go through.
install_guard() {
  local dir h
  install_secrets
  git config ramify.guardMain true
  dir=$(git rev-parse --path-format=absolute --git-path hooks)
  for h in pre-commit pre-push; do
    grep -q '^# ramify: secret scan' "$dir/$h" 2>/dev/null \
      || log "${Y}! $dir/$h is not ramify's: git does not guard the default branch there until it calls $SELF_DIR/snippets/git-hooks/ramify-secrets${N}"
  done
  log "${G}+${N} ramify.guardMain: git refuses commits on the default branch in the main checkout, and pushes to it (RAMIFY_ALLOW_MAIN=1 lets one through)"
}

# The instruction files of the agents that read them, relative to $HOME (one line: the app reads it from here).
INSTRUCTION_FILES=".claude/CLAUDE.md .codex/AGENTS.md .gemini/GEMINI.md .config/opencode/AGENTS.md .copilot/copilot-instructions.md .config/amp/AGENTS.md"

install_instructions() {
  local snippet="$SELF_DIR/snippets/agent-instructions.md" f
  [ -f "$snippet" ] || die "missing $snippet"
  for f in $INSTRUCTION_FILES; do
    f="$HOME/$f"
    [ -d "$(dirname "$f")" ] || continue
    if grep -qE '^## .*\((ramify|agent-wt)\)' "$f" 2>/dev/null; then
      # Already there: replace it when the snippet changed (a newer ramify), leave it otherwise.
      awk '/^## .*\((ramify|agent-wt)\)/ { on = 1; print; next } on && (/^$/ || /^#/) { exit } on { print }' "$f" \
        | cmp -s - "$snippet" && { log "${D}= $f${N}"; continue; }
      backup_once "$f"
      awk '/^## .*\((ramify|agent-wt)\)/ { skip = 1; next } skip && (/^$/ || /^#/) { skip = 0 } !skip { print }' "$f" \
        | awk '{ l[NR] = $0 } END { n = NR; while (n > 0 && l[n] == "") n--; for (i = 1; i <= n; i++) print l[i] }' > "$f.ramify-tmp" \
        && mv "$f.ramify-tmp" "$f"
      { [ -s "$f" ] && printf '\n'; cat "$snippet"; } >> "$f"
      log "${G}~${N} $f"
      continue
    fi
    backup_once "$f"
    { [ -s "$f" ] && printf '\n'; cat "$snippet"; } >> "$f"
    log "${G}+${N} $f"
  done
}

# --- one branch per agent, from the terminal ---------------------------------

# Commands the shell integration hands to `ramify run`.
SHELL_AGENTS="claude codex gemini copilot cursor-agent opencode qwen kimi vibe grok amp droid goose crush aider auggie cline kilocode kiro-cli deepcode iflow qodo junie"
SHELL_BEGIN="# >>> ramify: one branch per agent >>>"
SHELL_END="# <<< ramify: one branch per agent <<<"

# Arguments that are not a conversation (scripts, setup, version…): those run untouched.
passthrough_args() {
  local a
  for a in "$@"; do
    case "$a" in
      -p|--print|-h|--help|-v|--version|-V|exec|mcp|config|doctor|update|upgrade|login|logout|auth|install|uninstall|completion|plugin|plugins|setup-token) return 0 ;;
    esac
  done
  return 1
}

# The default branch: origin's HEAD, else main / master / trunk / develop.
default_branch() {
  local b
  b=$(git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) && { printf '%s' "${b#origin/}"; return; }
  for b in main master trunk develop; do git -C "$1" show-ref --verify --quiet "refs/heads/$b" && { printf '%s' "$b"; return; }; done
}

# `ramify run <agent> [args]`: started from a repository's main checkout on its default branch, the agent
# gets a branch and a folder of its own first. Anywhere else it runs exactly as typed.
cmd_run() {
  local agent="${1:-}" real main top branch nb n rel wt
  [ -n "$agent" ] || die "usage: ramify run <agent> [args]"
  shift
  real=$(command -v "$agent") || die "command not found: $agent"
  # Only a conversation in a terminal (RAMIFY_INTERACTIVE=1 says so without one, for tests).
  if [ -z "${RAMIFY_INTERACTIVE:-}" ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then exec "$real" "$@"; fi
  if [ -n "${RAMIFY_NO_BRANCH:-}" ] || passthrough_args "$@"; then exec "$real" "$@"; fi
  top=$(git rev-parse --show-toplevel 2>/dev/null) || exec "$real" "$@"
  main=$(main_checkout "$PWD" 2>/dev/null) || exec "$real" "$@"
  # Already in a worktree, or on a branch of its own: nothing to do.
  [ "$(cd "$top" && abspwd)" = "$main" ] || exec "$real" "$@"
  branch=$(git -C "$main" branch --show-current)
  [ -n "$branch" ] && [ "$branch" = "$(default_branch "$main")" ] || exec "$real" "$@"
  git -C "$main" rev-parse --verify --quiet HEAD >/dev/null || exec "$real" "$@"

  nb="${agent%-agent}/$(date +%m%d-%H%M)"; n=2
  while git -C "$main" show-ref --verify --quiet "refs/heads/$nb" || [ -e "$ROOT/$(basename "$main")/$(slugify "$nb")" ]; do
    nb="${agent%-agent}/$(date +%m%d-%H%M)-$n"; n=$((n + 1))
  done
  rel=${PWD#"$main"}
  log "${M}ramify${N}: ${B}$agent${N} gets its own branch ${M}$nb${N} (you stay on $branch; RAMIFY_NO_BRANCH=1 to skip)"
  [ -z "$(git -C "$main" status --porcelain --untracked-files=no)" ] || log "${D}uncommitted changes in $branch stay there; the new branch starts from its last commit${N}"
  create "$nb" "" 1 "${agent%-agent}"; wt=$CREATED_WT
  # Same subfolder as where you typed the command.
  if [ -n "$rel" ] && [ -d "$wt$rel" ]; then cd "$wt$rel"; else cd "$wt"; fi
  load_env "$wt"
  exec "$real" "$@"
}

# `ramify move <branch> [-a agent]`: the uncommitted work of the main checkout goes to a new branch and folder
# of its own, and the main checkout is left clean. A stash keeps a copy until you drop it yourself.
cmd_move() {
  local branch="" agent="" main stash wt
  while [ $# -gt 0 ]; do
    case "$1" in
      -a|--agent) agent=$2; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *) branch=$1; shift ;;
    esac
  done
  [ -n "$branch" ] || die "usage: ramify move <branch> [-a agent]"
  main=$(main_checkout "$PWD")
  [ "$(cd "$(git rev-parse --show-toplevel)" && abspwd)" = "$main" ] || die "run it from the main checkout: this is already a worktree"
  if [ -z "$(git -C "$main" status --porcelain)" ]; then
    log "${D}nothing uncommitted to move; creating $branch from the last commit${N}"
    create "$branch" "" 1 "$agent"; printf '%s\n' "$CREATED_WT"; return 0
  fi
  git -C "$main" stash push --include-untracked -m "ramify: moved to $branch" >/dev/null || die "could not stash the changes"
  stash=$(git -C "$main" rev-parse 'stash@{0}')
  # The branch starts where the work started: the commit the changes were made on. create runs here, not in
  # $(...) where bash 3.2 drops errexit; when it stops (the folder exists, a bad name, no free ports…) the work
  # comes back before ramify exits. (The trap is a fixed string: these variables are local.)
  # shellcheck disable=SC2064
  trap "git -C $(printf '%q' "$main") stash pop --index >/dev/null 2>&1 || git -C $(printf '%q' "$main") stash pop >/dev/null 2>&1
    log $(printf '%q' "${R}ramify:${N} could not create $branch; the changes are back in the main checkout")" EXIT
  create "$branch" "" 1 "$agent"
  trap - EXIT
  wt=$CREATED_WT
  if ! git -C "$wt" stash apply --index "$stash" >/dev/null 2>&1 && ! git -C "$wt" stash apply "$stash" >/dev/null 2>&1; then
    git -C "$main" stash pop >/dev/null 2>&1
    die "the changes did not apply to $branch; they are back in the main checkout"
  fi
  log "${G}→${N} uncommitted work moved to ${M}$branch${N} ($wt); the main checkout is clean"
  log "${D}a copy stays in the stash (\"ramify: moved to $branch\"); drop it with: git stash drop${N}"
  printf '%s\n' "$wt"
}

# Shell functions that route the agents installed here through `ramify run`.
cmd_shell_init() {
  local bin a
  bin=$(cd "$SELF_DIR" && pwd)/ramify
  printf '# ramify: an agent opened in a repository main checkout gets its own branch and folder.\n'
  for a in $SHELL_AGENTS; do
    command -v "$a" >/dev/null 2>&1 || continue
    printf '%s() { %q run %s "$@"; }\n' "$a" "$bin" "$a"
  done
}

shell_rc() {
  case "${SHELL:-}" in
    */bash) printf '%s' "$HOME/.bashrc" ;;
    *) printf '%s' "$HOME/.zshrc" ;;
  esac
}

# Remove the "## Worktrees (ramify)" section that install_instructions added (up to the next heading or blank line).
uninstall_instructions() {
  local f tmp
  for f in $INSTRUCTION_FILES; do
    f="$HOME/$f"
    grep -qE '^## .*\((ramify|agent-wt)\)' "$f" 2>/dev/null || continue
    backup_once "$f"
    tmp="$f.ramify-tmp"
    awk '/^## .*\((ramify|agent-wt)\)/ { skip = 1; next } skip && (/^$/ || /^#/) { skip = 0 } !skip { print }' "$f" > "$tmp" && mv "$tmp" "$f"
    log "${G}-${N} $f"
  done
}

install_shell() {
  local rc bin
  rc=$(shell_rc); bin=$(cd "$SELF_DIR" && pwd)/ramify
  if grep -qF "$SHELL_BEGIN" "$rc" 2>/dev/null; then log "${D}= $rc${N}"; return 0; fi
  backup_once "$rc"
  printf '\n%s\n[ -x %q ] && eval "$(%q shell-init)"\n%s\n' "$SHELL_BEGIN" "$bin" "$bin" "$SHELL_END" >> "$rc"
  log "${G}+${N} $rc: agents opened in a main checkout now get their own branch (new terminals)"
}

uninstall_shell() {
  local rc tmp
  rc=$(shell_rc)
  grep -qF "$SHELL_BEGIN" "$rc" 2>/dev/null || { log "${D}= $rc${N}"; return 0; }
  backup_once "$rc"
  tmp="$rc.ramify-tmp"
  awk -v b="$SHELL_BEGIN" -v e="$SHELL_END" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$rc" > "$tmp" && mv "$tmp" "$rc"
  log "${G}-${N} $rc: agents run as typed again (new terminals)"
}

# --- arguments ---------------------------------------------------------------

sub="${1:-}"
[ $# -gt 0 ] && shift
case "$sub" in
  new|open)
    [ $# -gt 0 ] || { usage; exit 1; }
    name=$1; shift
    agent=""; ide=""; from=""; prompt=""; tmux=0; setup=1; nolaunch=0
    while [ $# -gt 0 ]; do
      case "$1" in
        -a|--agent) agent=$2; shift 2 ;;
        -i|--ide) ide=$2; shift 2 ;;
        -p|--prompt) prompt=$2; shift 2 ;;
        -f|--from) from=$2; shift 2 ;;
        --tmux) tmux=1; shift ;;
        --no-setup) setup=0; shift ;;
        --no-launch) nolaunch=1; shift ;;
        --) shift; break ;;
        *) die "unknown option: $1" ;;
      esac
    done
    if [ "$sub" = new ]; then
      create "$name" "$from" "$setup" "$agent"; wt=$CREATED_WT
      if [ "$nolaunch" = 1 ]; then printf '%s\n' "$wt"; exit 0; fi
    else
      main=$(main_checkout "$PWD"); wt=$(find_wt "$main" "$name")
    fi
    launch "$wt" "$agent" "$ide" "$prompt" "$tmux" "$@" ;;
  ls|list) cmd_ls "$@" ;;
  graph) cmd_graph "$@" ;;
  who) cmd_who "$@" ;;
  ready) cmd_ready "$@" ;;
  ui) cmd_ui "$@" ;;
  app) cmd_app ;;
  path)
    [ $# -gt 0 ] || { usage; exit 1; }
    main=$(main_checkout "$PWD"); find_wt "$main" "$1" ;;
  rm|remove)
    [ $# -gt 0 ] || { usage; exit 1; }
    force=0; squashed=""
    case "${2:-}" in
      --force) force=1 ;;
      --squashed) [[ "${3:-}" =~ ^[0-9a-f]{40}$ ]] || die "--squashed needs the full commit of the merged pull request"; squashed=$3 ;;
    esac
    main=$(main_checkout "$PWD")
    wt=$(find_wt "$main" "$1")
    remove_wt "$main" "$wt" "$force" "$squashed" ;;
  prune) cmd_prune ;;
  hook) cmd_hook "$@" ;;
  run) cmd_run "$@" ;;
  move) cmd_move "$@" ;;
  shell-init) cmd_shell_init ;;
  install)
    case "${1:-all}" in
      claude-plugin) install_claude_plugin ;;
      claude-hooks) install_claude_hooks ;;
      instructions) install_instructions ;;
      shell) install_shell ;;
      secrets) install_secrets ;;
      guard) install_guard ;;
      all) if command -v claude >/dev/null; then install_claude_plugin; else install_claude_hooks; fi; install_instructions ;;
      *) die "usage: ramify install [claude-plugin|claude-hooks|instructions|shell|secrets|guard|all]" ;;
    esac ;;
  uninstall)
    case "${1:-}" in
      shell) uninstall_shell ;;
      instructions) uninstall_instructions ;;
      *) die "usage: ramify uninstall [shell|instructions]" ;;
    esac ;;
  -v|--version|version) echo "ramify $VERSION" ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
