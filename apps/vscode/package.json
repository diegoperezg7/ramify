{
  "name": "ramify",
  "displayName": "Ramify",
  "description": "One git worktree per task for any coding agent: live branch tree, diffs, merge and launch agents from the editor.",
  "version": "0.7.8",
  "publisher": "diegoperezg7",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": { "type": "git", "url": "https://github.com/diegoperezg7/ramify" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["SCM Providers", "Other"],
  "keywords": ["git", "worktree", "agents", "claude", "codex"],
  "main": "./dist/extension.cjs",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "Ramify runs git and the project's setup scripts in this folder, so it needs a trusted workspace." }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "ramify", "title": "Ramify", "icon": "media/activity.svg" }
      ]
    },
    "views": {
      "ramify": [
        { "type": "webview", "id": "ramify.home", "name": "Branches" }
      ]
    },
    "commands": [
      { "command": "ramify.open", "title": "Ramify: Open dashboard", "icon": "$(git-branch)" },
      { "command": "ramify.new", "title": "Ramify: New worktree" }
    ],
    "keybindings": [
      { "command": "ramify.open", "key": "ctrl+alt+w", "mac": "cmd+alt+w" }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && vsce package --no-dependencies --out ramify.vsix",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
