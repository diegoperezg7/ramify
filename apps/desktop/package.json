{
  "name": "ramify-desktop",
  "productName": "Ramify",
  "description": "One git worktree per task, for any coding agent",
  "version": "0.6.0",
  "private": true,
  "author": "Diego Pérez",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && node dist.mjs",
    "typecheck": "tsc -p .",
    "dist:win": "node build.mjs && electron-builder --win --publish never",
    "smoke": "node smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "io.github.diegoperezg7.ramify",
    "productName": "Ramify",
    "copyright": "Copyright © 2026 Diego Pérez",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../ramify",
        "to": "bin/ramify"
      },
      {
        "from": "../../snippets",
        "to": "bin/snippets"
      },
      {
        "from": "../../.claude-plugin",
        "to": "claude-marketplace/.claude-plugin"
      },
      {
        "from": "../../claude-plugin",
        "to": "claude-marketplace/claude-plugin"
      },
      {
        "from": "resources/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "resources/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      },
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      },
      {
        "from": "resources/tray",
        "to": "tray"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true,
      "extendInfo": {
        "LSUIElement": false
      },
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Ramify",
      "background": "resources/dmg-background.tiff",
      "iconSize": 96,
      "window": { "width": 660, "height": 400 },
      "contents": [
        { "x": 180, "y": 190, "type": "file" },
        { "x": 480, "y": 190, "type": "link", "path": "/Applications" }
      ]
    },
    "electronVersion": "45.2.2",
    "electronDist": "../../node_modules/electron/dist",
    "protocols": [
      {
        "name": "Ramify",
        "schemes": [
          "ramify"
        ]
      }
    ],
    "artifactName": "ramify-${version}-${arch}.${ext}",
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Ramify"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
