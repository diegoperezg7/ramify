{
  "name": "ramify-desktop",
  "productName": "Ramify",
  "description": "One git worktree per task, for any coding agent",
  "version": "0.5.0",
  "private": true,
  "author": "Diego Pérez",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --mac --publish never",
    "typecheck": "tsc -p .",
    "dist:win": "node build.mjs && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "io.github.diegoperezg7.ramify",
    "productName": "Ramify",
    "copyright": "Copyright © 2026 Diego Pérez",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../ramify",
        "to": "bin/ramify"
      },
      {
        "from": "resources/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "resources/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      },
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "darkModeSupport": true,
      "extendInfo": {
        "LSUIElement": false
      }
    },
    "dmg": {
      "title": "Ramify",
      "iconSize": 96
    },
    "electronVersion": "45.2.2",
    "electronDist": "../../node_modules/electron/dist",
    "protocols": [
      {
        "name": "Ramify",
        "schemes": [
          "ramify"
        ]
      }
    ],
    "artifactName": "ramify-${version}-${arch}.${ext}",
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Ramify"
    }
  }
}
